# ============================================
# Configuración de Base de Datos
# ============================================
# Usa las variables DB_* para configuración manual
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=test_web_excel1

# Railway proporciona automáticamente MYSQL_* cuando añades
# el plugin MySQL de Railway. No necesitas configurarlas manualmente.
# Las variables DB_* se usan como fallback si MYSQL_* no existen.
# MYSQL_HOST
# MYSQL_PORT
# MYSQL_USER
# MYSQL_PASSWORD
# MYSQL_DATABASE

# ============================================
# Configuración del Servidor
# ============================================
PORT=3000

# Origen permitido para CORS (* para cualquier origen en desarrollo)
CORS_ORIGIN=*
